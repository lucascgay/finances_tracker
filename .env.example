DATABASE_URL="file:./dev.db"

# --- LLM provider (pick ONE) ---
# Option A: local Ollama (fully offline, recommended)
LLM_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"

# Option B: OpenAI-compatible API (e.g. OpenAI, OpenRouter, Groq...)
# LLM_PROVIDER="openai"
# OPENAI_API_KEY="sk-..."
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o-mini"

# --- PDF extraction (optional) ---
# By default PDF extraction uses py/.venv/bin/python (via `uv sync` in py/).
# Override only if you use a different interpreter/environment.
# PDF_PYTHON="python3"
